# Upstash Redis (replaces deprecated Vercel KV)
# Get these from Vercel Storage dashboard → Add Store → Upstash Redis
# Or directly from upstash.com → Create Database → REST API tab
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google Gemini — used for AI portfolio analysis and the Investment Advisor chatbot (Gemini 3.8 Flash)
# Free tier available — get a key at aistudio.google.com
GEMINI_API_KEY=

# Anthropic Claude — Claude Sonnet 5 and Claude Opus 5 providers
# Get an API key at console.anthropic.com
ANTHROPIC_API_KEY=

# Dashboard password, checked server-side. All /api routes and the page require a login
# cookie issued after entering it. Required in production (requests are rejected without it);
# in local dev, leaving it blank disables the login.
DASHBOARD_PASSWORD=
# Optional: separate key for signing session cookies (defaults to DASHBOARD_PASSWORD)
AUTH_SECRET=

# Optional: bearer token for GET /api/day-change, a read-only feed that returns only today's net
# dollar change (used by the Mission Control sidebar). Generate with `openssl rand -hex 32`.
# Unset = the endpoint always returns 401.
DAY_CHANGE_TOKEN=
